pkgname=kwiklook
pkgver=0.5.0
pkgrel=1
pkgdesc='Quick previews of files from Dolphin'
arch=('x86_64')
url='https://github.com/strandzen/KwikLook'
license=('GPL-3.0-or-later')
depends=(
  'dolphin'
  'gcc-libs'
  'glibc'
  'kconfig'
  'kcoreaddons'
  'kfilemetadata'
  'ki18n'
  'kio'
  'kirigami'
  'kirigami-addons'
  'kservice'
  'kwindowsystem'
  'libarchive'  # kwiklook-archive: what's inside archives
  'purpose'
  'qt6-base'
  'qt6-declarative'
  'qt6-multimedia'
  'qt6-multimedia-ffmpeg'  # its playback backend
  'qt6-webengine'  # QtQuick.Pdf
  'syntax-highlighting'
  'libseccomp'  # kwiklook-sandbox
)
optdepends=(
  'libreoffice: previews of office documents'
  'kcontacts: contacts (.vcf) shown as cards'
  'kcalendarcore: calendar files (.ics) shown as cards'
)
makedepends=('cmake' 'extra-cmake-modules' 'kcontacts' 'kcalendarcore')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
# After pushing a new tag: updpkgsums (or gh release download vX --archive=tar.gz while the repository is private)
sha256sums=('9456ba6c30f23d2aeb58c54d7589844d6a1fc9dba74add9265294e1c7d465c3e')

build() {
  cmake -B build -S "KwikLook-$pkgver" \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DBUILD_TESTING=OFF
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
