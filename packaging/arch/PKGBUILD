pkgname=kwiklook
pkgver=0.2.0
pkgrel=1
pkgdesc='Quick previews of files from Dolphin'
arch=('x86_64')
url='https://github.com/strandzen/KwikLook'
license=('GPL-3.0-or-later')
depends=(
  'dolphin'
  'gcc-libs'
  'glibc'
  'kconfig'
  'kcoreaddons'
  'kfilemetadata'
  'ki18n'
  'kio'
  'kirigami'
  'kirigami-addons'
  'kservice'
  'kwindowsystem'
  'purpose'
  'qt6-base'
  'qt6-declarative'
  'qt6-multimedia'
  'qt6-multimedia-ffmpeg'  # its playback backend
  'qt6-webengine'  # QtQuick.Pdf
  'syntax-highlighting'
  'libseccomp'  # kwiklook-sandbox
)
optdepends=('libreoffice: previews of office documents')
makedepends=('cmake' 'extra-cmake-modules')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
# After pushing a new tag: updpkgsums (or gh release download vX --archive=tar.gz while the repository is private)
sha256sums=('6c2d87ef8a8091b7f7c3ed8a4797a08cdff7def795955bb3ff0a9466190f3d04')

build() {
  cmake -B build -S "KwikLook-$pkgver" \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DBUILD_TESTING=OFF
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
