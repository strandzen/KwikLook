pkgname=kwiklook
pkgver=0.3.0
pkgrel=1
pkgdesc='Quick previews of files from Dolphin'
arch=('x86_64')
url='https://github.com/strandzen/KwikLook'
license=('GPL-3.0-or-later')
depends=(
  'dolphin'
  'exiv2'  # photo metadata kept when a picture is edited
  'gcc-libs'
  'glibc'
  'kcalendarcore'  # event cards (.ics)
  'kconfig'
  'kcontacts'  # contact cards (.vcf)
  'kcoreaddons'
  'kfilemetadata'
  'ki18n'
  'kio'
  'kirigami'
  'kirigami-addons'
  'kservice'
  'kwindowsystem'
  'libarchive'  # kwiklook-archive: what's inside archives
  'purpose'
  'qt6-base'
  'qt6-declarative'
  'qt6-multimedia'
  'qt6-multimedia-ffmpeg'  # its playback backend
  'qt6-webengine'  # QtQuick.Pdf
  'syntax-highlighting'
  'libseccomp'  # kwiklook-sandbox
)
optdepends=(
  'libreoffice: previews of office documents'
  'ffmpeg: trimming and rotating videos'
)
makedepends=('cmake' 'extra-cmake-modules')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
# After pushing a new tag: updpkgsums (or gh release download vX --archive=tar.gz while the repository is private)
sha256sums=('37c25827605a265f9df140ce7d7d419100ab8eedcb14e6086f67ca4bebe2c713')

build() {
  cmake -B build -S "KwikLook-$pkgver" \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DBUILD_TESTING=OFF
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
